{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "trails-test-data",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "--no-warnings",
        "services/trails/import/dev-server.mjs",
        "services/trails/.data/tennessee.sqlite"
      ],
      "port": 8788
    },
    {
      "name": "web",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081
    },
    {
      "name": "phone",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--dev-client",
        "--lan",
        "--port",
        "8081"
      ],
      "port": 8081
    }
  ]
}
