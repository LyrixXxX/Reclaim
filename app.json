{
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-3940256099942544~3347511713",
    "delay_app_measurement_init": true
  },
  "expo": {
    "name": "Reclaim",
    "slug": "reclaim",
    "version": "1.0.56",
    "orientation": "default",
    "icon": "./assets/images/reclaim-icon.png",
    "scheme": "reclaim",
    "userInterfaceStyle": "dark",
    "ios": {
      "icon": "./assets/images/reclaim-icon-ios.png"
    },
    "android": {
      "versionCode": 57,
      "permissions": ["android.permission.ACTIVITY_RECOGNITION", "android.permission.POST_NOTIFICATIONS", "android.permission.RECEIVE_BOOT_COMPLETED"],
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/images/reclaim-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.greekkid60.reclaim"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/reclaim-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-android-widget",
        {
          "fonts": ["./node_modules/@expo-google-fonts/manrope/700Bold/Manrope_700Bold.ttf", "./node_modules/@expo-google-fonts/manrope/800ExtraBold/Manrope_800ExtraBold.ttf"],
          "widgets": [
            {
              "name": "QuitTimer",
              "label": "Reclaim quit timer",
              "description": "Days quit, money saved and your next milestone",
              "minWidth": "180dp",
              "minHeight": "150dp",
              "targetCellWidth": 3,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ],
      ["expo-camera", { "cameraPermission": "Allow Reclaim to photograph nutrition and supplement labels for optional AI scanning.", "recordAudioAndroid": false }],
      "./plugins/with-reclaim-signing",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0D0C",
          "image": "./assets/images/reclaim-icon.png",
          "imageWidth": 120
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Reclaim to select nutrition labels for food logging.",
          "cameraPermission": "Allow Reclaim to photograph nutrition labels for food logging.",
          "microphonePermission": false
        }
      ],
      "expo-image",
      "expo-font",
      "expo-sharing",
      "expo-status-bar",
      "expo-web-browser",
      "expo-notifications",
      "expo-secure-store",
      "expo-iap",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "delayAppMeasurementInit": true
        }
      ],
      [
        "expo-build-properties",
        { "android": { "minSdkVersion": 26, "enableMinifyInReleaseBuilds": true, "enableShrinkResourcesInReleaseBuilds": true, "extraProguardRules": "-keep class * extends androidx.room.RoomDatabase { <init>(); }\n-keep class * extends androidx.work.InputMerger { <init>(); }" } }
      ],
      "@maplibre/maplibre-react-native",
      [
        "expo-location",
        {
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "locationWhenInUsePermission": "Allow Reclaim to show your position and record a walk or hike only when you start one.",
          "locationAlwaysAndWhenInUsePermission": "Allow Reclaim to continue recording an active walk or hike while the phone is locked."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Reclaim to use Face ID to unlock your private records."
        }
      ],
      "./plugins/with-adaptive-android-ui"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c3ed7b55-8c28-495f-947a-291cfdb6db63"
      }
    }
  }
}
