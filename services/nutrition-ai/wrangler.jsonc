{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reclaim-nutrition-ai",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-19",
  "vars": {
    "OPENAI_MODEL": "gpt-6-astra"
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 20,
        "period": 60
      }
    }
  ]
}
