{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reclaim-trails",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    // Requests carry a search location in the query string, so it must never reach logs.
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "secrets": {
    "required": ["GOOGLE_SERVICE_ACCOUNT_JSON"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reclaim-trails",
      // Not created yet. Replace with the id from `wrangler d1 create reclaim-trails`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "3001",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "3002",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
