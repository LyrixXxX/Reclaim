{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "reclaim-play-purchases",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-19",
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    }
  },
  "secrets": {
    "required": ["GOOGLE_SERVICE_ACCOUNT_JSON"]
  },
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "2001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "2002",
      "simple": { "limit": 300, "period": 60 }
    }
  ]
}
